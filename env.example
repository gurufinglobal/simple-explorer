# Simple-Explorer 공개 환경 설정 안내 — 이 파일은 자동 로딩되지 않습니다.
# 개발: cp env.example .env.development.local 후 npm run dev
# 로컬 production: cp env.example .env.production.local 후 npm run build && npm start
# 공통 개인 설정: .env.local (test에서는 무시)
# 테스트: 추적된 .env.test 사용. 개인 override는 .env.test.local.
# process.env > .env.<mode>.local > .env.local (test 제외) > .env.<mode> > .env
# 우선순위는 변수별입니다. 빈 상위 파일은 하위 파일 로딩을 막지 않습니다.
# NODE_ENV는 Next/Vitest가 development/production/test로 정합니다. staging 금지.
# test 설정을 읽히게 하려고 NODE_ENV=test로 Next dev/build를 실행하지 마세요.
# 공개 변수는 브라우저에 노출됩니다. 비밀/개인 지갑 값을 넣지 마세요.
# 변경 후 개발 서버 재시작, production 재빌드가 필요합니다.
# 아래 URL은 공개 예시이며 가용성·CORS·서명 지원을 보장하지 않습니다.

# 1. 기본 복사 블록: TRPC 단일 체인 (key=default, name=Default)
# JSON이 없을 때 LCD는 필수, 나머지 endpoint는 선택입니다.
NEXT_PUBLIC_LCD_URL=https://trpc.gurufin.io:1317
NEXT_PUBLIC_RPC_URL=https://trpc.gurufin.io:26657
NEXT_PUBLIC_EVM_RPC_URL=https://trpc.gurufin.io:8545
NEXT_PUBLIC_WS_URL=wss://trpc.gurufin.io:26657/websocket
# RPC/EVM 누락 시 해당 기능은 오류/차단됩니다. WS 설정은 WS 기능 구현을 뜻하지 않습니다.

# 2. TGXN 대안: 위 활성 TRPC 4줄을 제거/주석 처리한 뒤 아래 두 줄 활성화.
# 예전 개발 자동 TGXN 선택은 종료되었습니다. 개발에도 명시적 설정이 필요합니다.
# NEXT_PUBLIC_CHAINS='[{"key":"tgxn","name":"TGXN","lcdUrl":"https://tgxn.gurufin.io:1317","rpcUrl":"https://tgxn.gurufin.io:26657","chainId":"guru_631-1","denom":"agxn","nativeDenom":"agxn","bondDenom":"agxn","evidence":["W01 2026-10-20T04:43:48Z: LCD/RPC guru_631-1; native/bond agxn. Terminal observation only; browser CORS and signing unverified."]}]'
# NEXT_PUBLIC_DEFAULT_CHAIN_KEY=tgxn
# 과거 W01 관찰 값을 명시한 예시이며 현재 가용성/CORS/서명 지원 검증이 아닙니다.
# key/호스트 기반 자동 보강은 없습니다. 입력 metadata/evidence는 보존하고 누락은 유지합니다.
# 최소 key/name/lcdUrl JSON도 유효하지만 RPC 누락은 HTTP 전 오류, nativeDenom 누락은 공급량 부분 오류입니다.
# 이전 최소 TGXN JSON은 해당 체인에서 확인한 metadata를 위처럼 명시한 뒤 재시작/재빌드하세요.
# JSON 누락 필드는 단일 체인 변수에서 병합하지 않습니다. 임의 체인에 TGXN 값을 복사하지 마세요.

# 3. 합성 다중 체인 문법 예시 (운영/서명 근거 아님). 다른 활성 블록을 먼저 제거하세요.
# NEXT_PUBLIC_CHAINS='[{"key":"alpha","name":"Example Alpha","lcdUrl":"https://alpha.example.invalid"},{"key":"beta","name":"Example Beta","lcdUrl":"https://beta.example.invalid","rpcUrl":"https://beta-rpc.example.invalid"}]'
# NEXT_PUBLIC_DEFAULT_CHAIN_KEY=alpha
# JSON은 큰따옴표의 배열로 쓰고 dotenv 값 전체를 작은따옴표로 감쌉니다.
# 유효 JSON이 단일 체인 변수보다 우선하지만, 명시된 단일 변수도 검증됩니다.
# 빈 문자열/잘못된 URL/JSON/빈 배열/중복 key/목록에 없는 default key는 오류입니다.
# default key 생략 시 첫 체인. JSON도 LCD도 없으면 구성 오류입니다.
# 다른 체인의 LCD만 override하면 하위 파일의 RPC 등이 남습니다.
# 체인 전환 시 관련 endpoint를 모두 변경하거나 완전한 NEXT_PUBLIC_CHAINS를 쓰세요.

# 4. 공통 선택 변수: 미설정은 빈 할당 대신 주석으로 유지합니다.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_ISSUED_PUBLIC_PROJECT_ID
# 미설정이면 WalletConnect를 사용할 수 없습니다. 실제 사용자 발급 ID를 로컬에서 입력.
# NEXT_PUBLIC_WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com
# 미설정 relay는 SDK 기본 동작을 사용합니다.
# NEXT_PUBLIC_EVM_CHAIN_ID=631
# 확인된 CAIP-2 eip155:<id>의 숫자 id 부분만 입력(예: 631). 위 숫자는 지원 근거 아님.
# NEXT_PUBLIC_BECH32_PREFIX=verifiedprefix
# 확인된 계정 prefix만 입력. 단일 체인 설정용이며 JSON에서는 체인별 필드 사용.
# NEXT_PUBLIC_GAS_PRICE는 지원하지 않습니다. 메시지별 fee policy를 사용하세요.

# 5. ChainConfigSchema 전체 옵션 (참조: src/lib/env.ts)
# 최소 실행 필드: key/name(빈 값 불가), lcdUrl(HTTP/S).
# 아래는 옵션 사전과 합성 JSON 조각이며 활성 설정이 아닙니다.
# 조각은 독립 dotenv 할당이 아닙니다. 필요할 때 NEXT_PUBLIC_CHAINS의 각 객체에 병합.
# 검증된 근거가 없는 권한/수수료/지갑 설정을 활성화하지 마세요.
#
# 식별자/endpoint 예시:
# {"key":"example","name":"Example","lcdUrl":"https://lcd.example.invalid",
#  "rpcUrl":"https://rpc.example.invalid","evmRpcUrl":"https://evm.example.invalid",
#  "wsUrl":"wss://rpc.example.invalid/websocket","evmChainId":"631",
#  "bech32Prefix":"example","denom":"aexample","chainId":"example-1",
#  "nativeDenom":"aexample","bondDenom":"aexample","feeDenom":"aexample","decimals":18}
# rpcUrl/evmRpcUrl은 HTTP/S, wsUrl은 URL. decimals는 0~30 정수.
# denom/nativeDenom/bondDenom/feeDenom은 서로 다른 역할이며 실제 관찰값만 지정.
#
# EVM metadata 예시:
# "evm":{"nativeCurrency":{"name":"Example","symbol":"EX","decimals":18},
#        "feeMode":"legacy","evidence":"실제 관찰 기록으로 대체"}
# nativeCurrency name은 비어 있지 않음, symbol 1~11자, decimals 0~255 정수.
# feeMode는 legacy 또는 eip1559. Cosmos decimals로 EVM 자산을 추정하지 않음.
# evmChainId/evmRpcUrl/evm metadata가 있어도 실제 지갑·거래 검증 완료는 아님.
#
# 서명 codec 예시:
# "signingProfile":{"family":"cosmos","chainVersion":"verified-version",
#   "accountTypeUrl":"/cosmos.auth.v1beta1.BaseAccount",
#   "pubkeyTypeUrl":"/cosmos.crypto.secp256k1.PubKey","addressAlgorithm":"cosmos",
#   "signModes":["direct"],"evidence":"실제 codec 관찰 기록으로 대체"}
# family: cosmos|ethermint|cosmos-evm; addressAlgorithm: cosmos|ethereum.
# accountTypeUrl/pubkeyTypeUrl은 /로 시작. signModes는 direct|amino의 비지 않은 배열.
# codec 근거는 지갑 또는 RPC origin 사용 권한과 별개입니다.
#
# Keplr 등록 예시:
# "keplrRegistration":{"coinType":118,"currency":"EX",
#   "bech32Config":{"bech32PrefixAccAddr":"example","bech32PrefixAccPub":"examplepub",
#     "bech32PrefixValAddr":"examplevaloper","bech32PrefixValPub":"examplevaloperpub",
#     "bech32PrefixConsAddr":"examplevalcons","bech32PrefixConsPub":"examplevalconspub"},
#   "gasPriceStep":{"low":0.01,"average":0.025,"high":0.04},"evidence":"실제 등록 근거로 대체"}
# coinType 0~2147483647 정수, currency 비어 있지 않음, gasPriceStep 3개 모두 양수.
# 6종 prefix는 각각 관찰해야 하며 계정 prefix에서 validator prefix를 추정하지 않음.
#
# 지갑/RPC 근거 예시:
# "signing":[{"wallet":"keplr","method":"direct","evidence":"실제 서명 관찰로 대체"}],
# "rpcAccess":{"origin":"https://explorer.example.invalid","get":true,"post":true,
#   "options":true,"observedAt":"실제 UTC 시각","evidence":"해당 origin CORS 근거로 대체"},
# "evidence":["공개 관찰 기록"]
# signing wallet은 keplr|walletconnect, method는 direct|amino. evidence 필수.
# rpcAccess의 GET/POST/OPTIONS는 모두 true와 관찰 근거 필요. URL 존재만으로 허용 안 함.
#
# 7개 조회 스위치 예시:
# "features":{"bank":true,"staking":true,"governance":true,"distribution":true,
#             "bex":false,"feepolicy":false,"oracle":false}
# 각 필드는 선택 boolean. bex/feepolicy/oracle은 명시적 true가 있어야 조회 허용.
# true는 기능 설정이며 live 계약 검증 완료를 뜻하지 않습니다.
#
# MsgSend 수수료 예시 (이 정책은 다른 메시지 권한을 부여하지 않음):
# "sendFeePolicy":{"mode":"simulate","gasPrice":"0.025aexample","gasMultiplierBps":13000,
#   "evidence":"실제 simulate 근거로 대체",
#   "fallback":{"gas":220000,"evidence":"실패 시 대체 gas의 검증 근거로 대체"}}
# simulate: gasPrice/evidence 필수, gasMultiplierBps 10000~100000 정수.
# fallback은 선택이며 gas(양의 안전 정수)/evidence 둘 다 필수. simulate 실패 시에만 사용.
# 고정 정책 대안:
# {"mode":"fixed","gasPrice":"0.025aexample","gas":220000,
#  "evidence":"실제 고정 gas 근거로 대체","limitation":"simulate 불가 사유와 정책 한계"}
# fixed: gasPrice/gas/evidence/limitation 필수. gas는 양의 안전 정수(<=9007199254740991).
# gasPrice 가격은 양수, denom은 확인된 feeDenom과 일치해야 합니다.
# 위 gas/가격은 합성 문법 예시이며 활성 성공값으로 사용하지 않습니다.
#
# stakingCapabilities: delegate/undelegate/reward/commission 각각 선택 capability.
# governanceCapabilities: vote/deposit/proposal 각각 선택 capability.
# 각 capability의 공통 구조:
# {"typeUrl":"/cosmos.staking.v1beta1.MsgDelegate",
#  "signing":[{"wallet":"keplr","method":"direct","evidence":"실제 메시지 서명 근거"}],
#  "fee":{"mode":"fixed","gasPrice":"0.025aexample","gas":220000,
#         "evidence":"실제 메시지 수수료 근거","limitation":"고정 gas 한계"},
#  "evidence":"실제 메시지 지원 근거"}
# typeUrl은 비어 있지 않음. signing은 비어 있지 않은 배열이며 위 wallet/method 규칙 적용.
# fee는 위 simulate/fixed 전체 계약 적용. 각 행위별 typeUrl/근거를 따로 확인하세요.
# 예: "stakingCapabilities":{"delegate":<공통 capability>,"undelegate":<공통 capability>,
#                               "reward":<공통 capability>,"commission":<공통 capability>}
# 예: "governanceCapabilities":{"vote":<공통 capability>,"deposit":<공통 capability>,
#                                  "proposal":<공통 capability + 선택 legacyContent>}
# <...>는 설명용 자리표시자이며 JSON 값이 아닙니다.
# proposal만 선택 "legacyContent":{"authority":"확인된 authority","evidence":"실제 근거"}
# 를 포함할 수 있습니다. authority/evidence는 비어 있지 않아야 합니다.
#
# 브라우저 검증 runner 변수(PLAYWRIGHT_MODULE/BROWSER_ORIGIN/BROWSER_OUTPUT 등)는
# 앱 공개 설정과 별개입니다. tests/README.md의 실행 문서를 참고하세요.
